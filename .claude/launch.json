{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "start"
      ],
      "port": 4200
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Depot.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5049
    }
  ]
}
